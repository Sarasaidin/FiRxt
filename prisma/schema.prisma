generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LocationSource {
  GEOCODED
  MANUAL_PIN
  NOT_SET
}

enum PartnerType {
  PHARMACY
  CLINIC
}

enum ProductType {
  PHYSICAL
  SERVICE
  BLOOD_TEST_PACKAGE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  READY_FOR_COLLECTION
  BOOKING_CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum FulfillmentType {
  IN_STORE_PICKUP
  IN_STORE_VISIT
  HOME_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClinicVisitStatus {
  REGISTERED
  CHECKED_IN
  SAMPLE_COLLECTED
  SAMPLE_SENT_TO_LAB
  LAB_REPORT_RECEIVED
  AI_REPORT_READY
  CONSULTATION_COMPLETED
  CANCELLED
}

enum PaymentRecoveryStatus {
  PENDING
  REFUNDING
  REFUNDED
  MANUAL_REVIEW
}

enum BloodTestPackageApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BloodTestPackageVisibility {
  PRIVATE
  SHARED
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole  @default(CUSTOMER)
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  orders       Order[]
  reviews      Review[]
  behaviorLogs BehaviorLog[]
  partners     Partner[]
  addresses    Address[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  postcode  String
  country   String  @default("MY")
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model BusinessType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partners Partner[]

  @@map("business_types")
}

model LabTest {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageLinks BloodTestPackageTest[]

  @@map("lab_tests")
}

model BloodTestPackage {
  id                      String                         @id @default(cuid())
  name                    String
  description             String?                        @db.Text
  price                   Int
  originalPrice           Int?
  preparationInstructions String?                        @db.Text
  sampleType              String?
  turnaroundDays          Int?
  ownerPartnerId          String?
  approvalStatus          BloodTestPackageApprovalStatus @default(PENDING)
  visibility              BloodTestPackageVisibility     @default(PRIVATE)
  isActive                Boolean                        @default(true)
  reviewedBy              String?
  reviewedAt              DateTime?
  rejectionReason         String?                        @db.Text
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  ownerPartner Partner? @relation("OwnedBloodTestPackages", fields: [ownerPartnerId], references: [id], onDelete: Restrict)
  packageTests BloodTestPackageTest[]
  clinicLinks  ClinicPackage[]
  orderItems   OrderItem[]

  @@index([ownerPartnerId])
  @@index([approvalStatus, visibility, isActive])
  @@map("blood_test_packages")
}

model BloodTestPackageTest {
  id        String  @id @default(cuid())
  packageId String
  labTestId String
  sortOrder Int     @default(0)
  notes     String?

  package BloodTestPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  labTest LabTest          @relation(fields: [labTestId], references: [id], onDelete: Restrict)

  @@unique([packageId, labTestId])
  @@index([labTestId])
  @@map("blood_test_package_tests")
}

model ClinicPackage {
  id            String   @id @default(cuid())
  clinicId      String
  packageId     String
  priceOverride Int?
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic  Partner          @relation("ClinicBloodTestPackages", fields: [clinicId], references: [id], onDelete: Restrict)
  package BloodTestPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@unique([clinicId, packageId])
  @@index([packageId])
  @@map("clinic_packages")
}

model Partner {
  id                         String        @id @default(cuid())
  userId                     String
  slug                       String        @unique
  name                       String
  businessTypeId             String?
  businessRegistrationNumber String?       @unique
  businessType               BusinessType? @relation(fields: [businessTypeId], references: [id])
  type                       PartnerType
  status                     PartnerStatus @default(PENDING)
  description                String?       @db.Text
  logoUrl                    String?
  bannerUrl                  String?
  phone                      String?
  email                      String?
  website                    String?

  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postcode       String
  country        String         @default("MY")
  latitude       Float?
  longitude      Float?
  locationSource LocationSource @default(NOT_SET)

  stripeAccountId String?
  operatingHours  Json?
  tags            String[]
  isVerified      Boolean   @default(false)
  approvedAt      DateTime?
  approvedBy      String?
  rejectedReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user                   User               @relation(fields: [userId], references: [id])
  products               Product[]
  services               Service[]
  orders                 Order[]
  reviews                Review[]
  promotions             Promotion[]
  promotionLinks         PromotionPartner[]
  analytics              PartnerAnalytic[]
  ownedBloodTestPackages BloodTestPackage[] @relation("OwnedBloodTestPackages")
  clinicPackages         ClinicPackage[]    @relation("ClinicBloodTestPackages")

  @@index([userId])
  @@index([businessTypeId])
  @@map("partners")
}

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  iconUrl  String?
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  services Service[]

  @@map("categories")
}

model Product {
  id                   String   @id @default(cuid())
  partnerId            String
  categoryId           String?
  name                 String
  slug                 String
  description          String?  @db.Text
  images               String[]
  price                Int
  comparePrice         Int?
  sku                  String?
  stock                Int      @default(0)
  isActive             Boolean  @default(true)
  isFeatured           Boolean  @default(false)
  tags                 String[]
  brand                String?
  requiresPrescription Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  partner        Partner         @relation(fields: [partnerId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  promotionItems PromotionItem[]
  reviews        Review[]

  @@unique([partnerId, slug])
  @@map("products")
}

model Service {
  id              String   @id @default(cuid())
  partnerId       String
  categoryId      String?
  name            String
  slug            String
  description     String?  @db.Text
  images          String[]
  price           Int
  durationMinutes Int?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner    Partner     @relation(fields: [partnerId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@unique([partnerId, slug])
  @@map("services")
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  userId         String
  partnerId      String
  addressId      String?
  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Int
  discountAmount Int           @default(0)
  deliveryFee    Int           @default(0)
  tax            Int           @default(0)
  total          Int

  stripePaymentIntentId String? @unique
  stripeSessionId       String? @unique

  promotionId String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id])
  partner     Partner              @relation(fields: [partnerId], references: [id])
  address     Address?             @relation(fields: [addressId], references: [id])
  promotion   Promotion?           @relation(fields: [promotionId], references: [id])
  items       OrderItem[]
  history     OrderStatusHistory[]
  clinicVisit ClinicVisit?

  fulfillmentType FulfillmentType?
  pickupAt        DateTime?
  visitAt         DateTime?

  @@map("orders")
}

model OrderItem {
  id         String      @id @default(cuid())
  orderId    String
  productId  String?
  serviceId  String?
  quantity   Int
  unitPrice  Int
  totalPrice Int
  itemType   ProductType

  bloodTestPackageId              String?
  packageNameSnapshot             String?
  includedTestsSnapshot           Json?
  preparationInstructionsSnapshot String? @db.Text

  order            Order             @relation(fields: [orderId], references: [id])
  product          Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  bloodTestPackage BloodTestPackage? @relation(fields: [bloodTestPackageId], references: [id], onDelete: Restrict)

  @@index([bloodTestPackageId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  createdBy String?

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}

model ClinicVisit {
  id                      String            @id @default(cuid())
  visitNumber             String            @unique
  orderId                 String            @unique
  status                  ClinicVisitStatus @default(REGISTERED)
  checkedInAt             DateTime?
  sampleCollectedAt       DateTime?
  sampleSentToLabAt       DateTime?
  labReportReceivedAt     DateTime?
  aiReportReadyAt         DateTime?
  consultationCompletedAt DateTime?
  notes                   String?           @db.Text
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("clinic_visits")
}

model Promotion {
  id            String          @id @default(cuid())
  partnerId     String?
  title         String
  description   String?         @db.Text
  bannerUrl     String?
  type          PromotionType
  status        PromotionStatus @default(DRAFT)
  discountValue Int
  minOrderValue Int?
  maxDiscount   Int?
  code          String?         @unique
  usageLimit    Int?
  usageCount    Int             @default(0)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  partner               Partner?           @relation(fields: [partnerId], references: [id])
  items                 PromotionItem[]
  participatingPartners PromotionPartner[]
  orders                Order[]

  @@map("promotions")
}

model PromotionItem {
  id          String @id @default(cuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@map("promotion_items")
}

model PromotionPartner {
  id          String   @id @default(cuid())
  promotionId String
  partnerId   String
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, partnerId])
  @@map("promotion_partners")
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  partnerId  String
  productId  String?
  rating     Int
  title      String?
  body       String?  @db.Text
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  partner Partner  @relation(fields: [partnerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model BehaviorLog {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  eventType  String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, eventType])
  @@index([entityType, entityId])
  @@map("behavior_logs")
}

model PartnerAnalytic {
  id        String   @id @default(cuid())
  partnerId String
  date      DateTime @db.Date
  views     Int      @default(0)
  clicks    Int      @default(0)
  orders    Int      @default(0)
  revenue   Int      @default(0)
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, date])
  @@map("partner_analytics")
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_config")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String    @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expiresAt])
  @@map("email_verifications")
}

model PaymentRecovery {
  id                    String                @id @default(cuid())
  stripeSessionId       String                @unique
  stripePaymentIntentId String?
  stripeRefundId        String?               @unique
  amount                Int
  currency              String                @default("myr")
  reason                String
  status                PaymentRecoveryStatus @default(PENDING)
  attempts              Int                   @default(0)
  lastError             String?               @db.Text
  claimToken            String?
  claimExpiresAt        DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("payment_recoveries")
}
